{
  "name": "codealpha-ecommerce-store",
  "version": "1.0.0",
  "description": "CodeAlpha Task 1: Full-Stack E-Commerce Store (AURA // ATELIER) with Hardened Security, Atomic ACID Checkout, and Modern Neo-Editorial UI",
  "main": "backend/server.js",
  "scripts": {
    "start": "node --no-warnings backend/server.js",
    "dev": "node --no-warnings --watch backend/server.js",
    "seed": "node --no-warnings backend/config/seed-cli.js",
    "test": "node --no-warnings --test tests/unit/*.test.js tests/integration/*.test.js tests/security/*.test.js",
    "test:unit": "node --no-warnings --test tests/unit/*.test.js",
    "test:api": "node --no-warnings --test tests/integration/*.test.js",
    "test:security": "node --no-warnings --test tests/security/*.test.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0"
  }
}
